# Lark Mail SMTP
SMTP_HOST=smtp.larksuite.com
SMTP_PORT=465
SMTP_SECURE=true

# Use the full HCOF mailbox address and a Lark app-specific SMTP password.
SMTP_USER=contact@your-domain.tld
SMTP_PASSWORD=replace-with-lark-app-password

# Contact form delivery
CONTACT_TO_EMAIL=contact@your-domain.tld
CONTACT_FROM_EMAIL=contact@your-domain.tld
CONTACT_FROM_NAME=HCOF Website

# Production CMS: Clerk authentication + PRIVATE Vercel Blob store.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ADMIN_EMAILS=admin@hcof.com
BLOB_READ_WRITE_TOKEN=

# Optional local development only. Never enabled on Vercel or production.
CMS_LOCAL_STORAGE=false
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
