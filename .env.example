# Lark Mail SMTP
SMTP_HOST=smtp.larksuite.com
SMTP_PORT=465
SMTP_SECURE=true

# Use the full HCOF mailbox address and a Lark app-specific SMTP password.
SMTP_USER=contact@your-domain.tld
SMTP_PASSWORD=replace-with-lark-app-password

# Contact form delivery
CONTACT_TO_EMAIL=contact@your-domain.tld
CONTACT_FROM_EMAIL=contact@your-domain.tld
CONTACT_FROM_NAME=HCOF Website
