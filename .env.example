# Lark Mail SMTP
SMTP_HOST=smtp.larksuite.com
SMTP_PORT=465
SMTP_SECURE=true

# Use the full HCOF mailbox address and a Lark app-specific SMTP password.
SMTP_USER=contact@your-domain.tld
SMTP_PASSWORD=replace-with-lark-app-password

# Contact form delivery
CONTACT_TO_EMAIL=contact@your-domain.tld
CONTACT_FROM_EMAIL=contact@your-domain.tld
CONTACT_FROM_NAME=HCOF Website

# Production CMS: PostgreSQL connection from Vercel Marketplace.
DATABASE_URL=
# Prisma/Vercel alternatives. Only standard postgres:// or postgresql:// URLs
# are used; prisma+postgres:// Accelerate URLs are not passed to the pg driver.
POSTGRES_URL=
PRISMA_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://www.hopescityoutreach.org
ADMIN_EMAILS=admin@hcof.com
# Set a strong password (12-128 characters) for the first deployment only.
# Remove this variable once the administrator account is created.
ADMIN_INITIAL_PASSWORD=
